generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ReviewStatus {
  NEW
  QUEUED
  DRAFTED
  APPROVED
  POSTED
  FLAGGED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
}

enum ReplyMode {
  AUTO
  APPROVAL
  DRAFT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  avatarUrl     String?
  role          Role     @default(OWNER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  memberships   Membership[]
  googleAccounts GoogleAccount[]
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Membership[]
  businesses  Business[]
  auditLogs   AuditLog[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model GoogleAccount {
  id                    String   @id @default(cuid())
  userId                String
  googleSubject         String   @unique
  email                 String
  encryptedRefreshToken String
  scopes                String[]
  expiresAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businesses            Business[]
}

model Business {
  id              String        @id @default(cuid())
  organizationId  String
  googleAccountId String
  googleAccountName String
  displayName     String
  primaryCategory String?
  locations       Location[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  googleAccount   GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)
  competitors     Competitor[]
  automationRules AutomationRule[]
  schedules       Schedule[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Location {
  id                 String   @id @default(cuid())
  businessId         String
  googleLocationName String   @unique
  title              String
  address            String?
  timezone           String?
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviews            Review[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Review {
  id               String       @id @default(cuid())
  locationId       String
  googleReviewName String       @unique
  reviewerName     String
  reviewerPhotoUrl String?
  rating           Int
  comment          String?
  languageCode     String?
  sentiment        Sentiment?
  status           ReviewStatus @default(NEW)
  keywords         String[]
  reviewedAt       DateTime
  syncedAt         DateTime     @default(now())
  location         Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  replies          ReviewReply[]
  aiAnalyses       AiAnalysis[]
  spamReports      SpamReport[]

  @@index([locationId, reviewedAt])
  @@index([status])
}

model ReviewReply {
  id              String   @id @default(cuid())
  reviewId        String
  body            String
  mode            ReplyMode
  postedToGoogle  Boolean  @default(false)
  postedAt        DateTime?
  createdByUserId String?
  review          Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiAnalysis {
  id          String    @id @default(cuid())
  reviewId    String?
  businessId  String?
  provider    String
  task        String
  sentiment   Sentiment?
  summary     String?
  jsonResult  Json
  review      Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Competitor {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  placeId         String?
  profileUrl      String?
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviews         CompetitorReview[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CompetitorReview {
  id           String     @id @default(cuid())
  competitorId String
  rating       Int
  comment      String?
  reviewedAt   DateTime
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

model SpamReport {
  id           String   @id @default(cuid())
  reviewId     String
  reason       String
  confidence   Float
  suggestedBody String?
  submittedAt  DateTime?
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model AutomationRule {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  condition   Json
  action      Json
  replyMode   ReplyMode
  enabled     Boolean   @default(true)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AutomationLog {
  id             String   @id @default(cuid())
  automationRuleId String?
  reviewId       String?
  status         String
  message        String?
  payload        Json?
  createdAt      DateTime @default(now())
}

model Schedule {
  id          String   @id @default(cuid())
  businessId  String
  jobType     String
  cron        String
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}
