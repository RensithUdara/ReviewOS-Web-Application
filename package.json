{
  "name": "review-maintain",
  "private": true,
  "version": "0.1.0",
  "description": "Google Business Profile review management SaaS starter.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:worker": "npm --workspace apps/worker run start:dev",
    "build": "npm-run-all --serial build:shared build:web build:api build:worker",
    "build:shared": "npm --workspace packages/shared run build",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "build:worker": "npm --workspace apps/worker run build",
    "lint": "npm-run-all --parallel lint:web lint:api lint:worker",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:api": "npm --workspace apps/api run lint",
    "lint:worker": "npm --workspace apps/worker run lint",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "typescript": "^5.6.2"
  }
}
